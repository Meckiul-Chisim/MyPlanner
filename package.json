{
  "name": "myplanner",
  "productName": "MyPlanner",
  "main": "out/main/main.js",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.48.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  },
  "build": {
    "appId": "com.meckiul.myplanner",
    "productName": "MyPlanner",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MyPlanner-Setup-${version}.${ext}",
      "icon": "build/icon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyPlanner",
      "installerLanguages": [
        "en_US"
      ],
      "language": 1033
    },
    "publish": {
      "provider": "github",
      "owner": "Meckiul-Chisim",
      "repo": "MyPlanner"
    }
  }
}
